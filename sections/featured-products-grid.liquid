        {
          "value": "square",
          "label": "t:sections.featured-collection.settings.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.featured-collection.settings.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.featured-collection.settings.image_shape.options__3.label"
        },
        {
          "value": "chevron",
          "label": "t:sections.featured-collection.settings.image_shape.options__4.label"
