<style>
  .modern-banner {
    position: relative;
    overflow: hidden;
    border-radius: var(--border-radius-lg);
    margin: var(--space-md) 0;
  }
  
  .modern-banner .banner__media {
    position: relative;
    height: 100%;
  }
  
  .modern-banner .banner-img {
    object-fit: cover;
    width: 100%;
    height: 100%;
    transition: transform var(--transition-normal);
  }
  
  .modern-banner:hover .banner-img {
    transform: scale(1.05);
  }
  
  .modern-banner .banner__content {
    padding: var(--space-md);
    z-index: 2;
  }
  
  .modern-banner .banner__box {
    border-radius: var(--border-radius-md);
    padding: var(--space-lg);
    box-shadow: var(--shadow-md);
    background-color: rgba(var(--color-background), 0.85);
    backdrop-filter: blur(8px);
    max-width: 600px;
  }
  
  .modern-banner .banner__heading {
    font-family: var(--font-secondary);
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--color-text-primary);
  }
  
  .modern-banner .banner__text {
    font-family: var(--font-primary);
    font-size: 1.6rem;
    line-height: 1.6;
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
  }
  
  .modern-banner .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 500;
  }
  
  .modern-banner .button .icon {
    transition: transform var(--transition-fast);
  }
  
  .modern-banner .button:hover .icon {
    transform: translateX(4px);
  }
  
  @media screen and (max-width: 749px) {
    .modern-banner .banner__box {
      padding: var(--space-md);
    }
    
    .modern-banner .banner__heading {
      font-size: 2rem;
    }
    
    .modern-banner .banner__text {
      font-size: 1.4rem;
    }
  }
</style>